# --- Groq ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Rate limits are per model, so switching models also gets you a fresh daily
# token budget. Alternatives: llama-3.3-70b-versatile, llama-3.1-8b-instant, and
# qwen/qwen3.6-27b (its <think> output is stripped automatically).
GROQ_MODEL=openai/gpt-oss-120b

# --- Neo4j (Hetionet) ---
# Defaults to the public read-only Hetionet instance, which has auth disabled.
# Leave NEO4J_PASSWORD blank for it; the driver then connects anonymously.
NEO4J_URI=bolt://neo4j.het.io:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Neo4j 3.5 (the public endpoint) cannot select a database — leave this empty.
# Set it only if you point NEO4J_URI at your own Neo4j 5.x instance.
NEO4J_DATABASE=

# --- Guardrails ---
QUERY_TIMEOUT_SECONDS=10
MAX_ROWS=25
# Cypher queries the agent may run per question before giving up.
MAX_QUERIES=5
