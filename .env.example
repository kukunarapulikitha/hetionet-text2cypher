# --- Groq ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Rate limits are per model, so switching models also gets you a fresh daily
# token budget. Alternatives: openai/gpt-oss-20b and qwen/qwen3.8-27b (its
# <think> output is stripped automatically).
GROQ_MODEL=openai/gpt-oss-120b

# --- Neo4j (Hetionet) ---
# Defaults to the public read-only Hetionet instance, which has auth disabled.
# Leave NEO4J_PASSWORD blank for it; the driver then connects anonymously.
NEO4J_URI=bolt://neo4j.het.io:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Neo4j 3.5 (the public endpoint) cannot select a database — leave this empty.
# Set it only if you point NEO4J_URI at your own Neo4j 5.x instance.
NEO4J_DATABASE=

# --- Guardrails ---
QUERY_TIMEOUT_SECONDS=10
MAX_ROWS=25
# Cypher queries the agent may run per question before giving up.
MAX_QUERIES=5

# --- LLM-as-a-judge (evaluate.py) ---
# Keep this different from GROQ_MODEL: a model grading its own output scores it
# too generously, and Groq's daily token cap is per model, so the judge gets a
# separate budget. Avoid reasoning models here — they blow the free tier's
# output-tokens-per-minute limit.
JUDGE_MODEL=openai/gpt-oss-20b
JUDGE_MAX_RETRIES=3
# Cap on the tool rows pasted into the judge prompt.
JUDGE_MAX_RESULT_CHARS=1500
# Minimum 1-5 score counted as a pass in the summary table.
JUDGE_PASS_SCORE=4

# --- Langfuse tracing (optional) ---
# Leave blank to disable tracing entirely; nothing is sent and nothing breaks.
# Free keys at https://cloud.langfuse.com (or self-host — see the README).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region by default; use https://us.cloud.langfuse.com for US.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
